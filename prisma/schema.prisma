// Jiji data model: issues, workflow status, priority, assignees, plus the
// tables Auth.js needs to persist Google logins.
//
// Keys look like JIJI-1, JIJI-2, ... and are derived from the auto-incrementing
// `number` column, which keeps them unique and monotonic without a counter table.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The workflow a ticket moves through.
enum IssueStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum IssuePriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

/// Global role: what a user may change. See src/lib/permissions.ts.
enum Role {
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  /// Set by the auth adapter from the Google profile picture.
  emailVerified DateTime?
  image         String?
  /// Hex colour for the avatar chip, derived from the id when the row is created.
  color         String    @default("#6366f1")
  role          Role      @default(MEMBER)
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  assignedIssues Issue[] @relation("IssueAssignee")
  reportedIssues Issue[] @relation("IssueReporter")
}

model Issue {
  id     String @id @default(cuid())
  /// Human-facing ticket number, rendered as JIJI-1, JIJI-2, ...
  number Int    @unique @default(autoincrement())
  title  String

  description String?
  status      IssueStatus   @default(TODO)
  priority    IssuePriority @default(MEDIUM)
  dueDate     DateTime?

  assigneeId String?
  assignee   User?   @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  reporterId String?
  reporter   User?   @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  /// Every issue lives in exactly one dashboard. Restrict: a dashboard that still
  /// has issues cannot be deleted, even if the API check is bypassed.
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([dashboardId, status])
}

/// A space that groups issues, e.g. one per project or team. Names are unique
/// regardless of case, via the raw `Dashboard_name_lower_key` index in the
/// dashboards migration (Prisma cannot express an index on lower(name)).
model Dashboard {
  id          String   @id @default(cuid())
  name        String
  description String?
  issues      Issue[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// --- Auth.js models ---
// Field names and indexes are fixed by @auth/prisma-adapter; do not rename.

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
