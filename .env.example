# Local Postgres running in the `jira-postgres` Podman container.
# See README.md -> "Start the database" for how this container is created.
DATABASE_URL="postgresql://jira:jira@localhost:5432/jira?schema=public"

# --- Auth.js / Google sign-in ---
# Generate a secret with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-random-string"

# From Google Cloud Console -> Google Auth Platform -> Clients -> Create client
# (older console: APIs & Services -> Credentials).
# Application type: "Web application".
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
# Client secret: also add http://localhost:3000 to "Authorised JavaScript origins".
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Which Google accounts may sign in, as bare domains. Comma-separated.
# Leave empty to allow any Google account. Set to "gmail.com" to restrict Jiji
# to personal Gmail addresses only.
AUTH_ALLOWED_DOMAINS="gmail.com"

# Sign-in is Google-only by default. Dev login is a passwordless convenience for
# local work without Google credentials; it is forced off whenever
# NODE_ENV=production, so it can never reach a deployed build. Leave unset.
# AUTH_DEV_LOGIN="true"

# Emails that are always Admins, comma-separated, compared case-insensitively.
# Listed users are promoted on every sign-in; removing an email never demotes
# anyone (use the Users page for that). Everyone else starts as a Member.
# ADMIN_EMAILS="you@gmail.com"
